# ═══════════════════════════════════════════════════
# Store Intelligence System — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and customize values

# ── General ──────────────────────────────────────
APP_NAME=Store Intelligence System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Video Ingestion ──────────────────────────────
VIDEO_FPS=5
VIDEO_FRAME_WIDTH=640
VIDEO_FRAME_HEIGHT=640
FRAME_BUFFER_SIZE=128
ENABLE_CLAHE=true
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_SIZE=8

# ── Detection (YOLOv8) ──────────────────────────
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.4
USE_CUDA=false
TARGET_CLASSES=[0,24,26,39,67]
TRACKER_TYPE=bytetrack.yaml

# ── Zones ────────────────────────────────────────
ZONES_CONFIG_PATH=config/zones.json
DWELL_ALERT_THRESHOLD_SECONDS=120
DWELL_UPDATE_INTERVAL_SECONDS=5
CROWD_THRESHOLD=10

# ── Business Hours ───────────────────────────────
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=21

# ── Streaming Backend ────────────────────────────
# Options: kafka | redis | memory
STREAM_BACKEND=memory

# ── Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=store
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500

# ── Redis ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_STREAM_MAXLEN=10000

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./store_intelligence.db

# ── API ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["*"]
API_RATE_LIMIT=100/minute

# ── Analytics ────────────────────────────────────
ANALYTICS_UPDATE_INTERVAL_SECONDS=30
FOOTFALL_SUMMARY_INTERVAL_SECONDS=60
STORE_SUMMARY_INTERVAL_SECONDS=300
ANOMALY_BASELINE_WINDOW_HOURS=24
ANOMALY_RETRAIN_INTERVAL_SECONDS=3600

# ── Anomaly Thresholds ──────────────────────────
LOITERING_THRESHOLD_SECONDS=300
ABANDONED_OBJECT_THRESHOLD_SECONDS=60
CHECKOUT_QUEUE_THRESHOLD=8
ZSCORE_THRESHOLD=2.5

# ── Metrics ──────────────────────────────────────
ENABLE_PROMETHEUS=true
METRICS_PORT=9090
